<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Unique identifier for this launch agent -->
    <key>Label</key>
    <string>com.superalignment.transcripts</string>

    <!-- Program to run -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/annhoward/src/superalignmenttoutopia/scripts/sync-and-rebuild-embeddings.sh</string>
    </array>

    <!-- Run at 2:00 AM daily -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Standard output log -->
    <key>StandardOutPath</key>
    <string>/Users/annhoward/src/superalignmenttoutopia/logs/launchd-transcripts-stdout.log</string>

    <!-- Standard error log -->
    <key>StandardErrorPath</key>
    <string>/Users/annhoward/src/superalignmenttoutopia/logs/launchd-transcripts-stderr.log</string>

    <!-- Working directory -->
    <key>WorkingDirectory</key>
    <string>/Users/annhoward/src/superalignmenttoutopia</string>

    <!-- Don't run at load (only at scheduled time) -->
    <key>RunAtLoad</key>
    <false/>

    <!-- Keep job alive if it exits (restart on failure) -->
    <key>KeepAlive</key>
    <false/>

    <!-- Environment variables -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
