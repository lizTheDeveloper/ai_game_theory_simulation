{
  "dashboard": {
    "title": "Event Timeline",
    "uid": "sim-timeline-09",
    "tags": ["simulation", "research-tool", "events", "timeline"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "5s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 1,
    "panels": [
      {
        "id": 1,
        "type": "stat",
        "title": "Total Events",
        "gridPos": { "x": 0, "y": 0, "w": 6, "h": 6 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "events_total",
            "refId": "A",
            "legendFormat": "Events"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "fixed",
              "fixedColor": "#00F0FF"
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "#00F0FF", "value": null }
              ]
            },
            "unit": "none",
            "decimals": 0
          },
          "overrides": []
        },
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "center",
          "orientation": "auto",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "textMode": "value_and_name",
          "text": {
            "titleSize": 14,
            "valueSize": 48
          }
        }
      },
      {
        "id": 2,
        "type": "stat",
        "title": "Critical Decisions",
        "gridPos": { "x": 6, "y": 0, "w": 6, "h": 6 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "critical_decisions_count",
            "refId": "A",
            "legendFormat": "Decisions"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "fixed",
              "fixedColor": "#FFB000"
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "#FFB000", "value": null }
              ]
            },
            "unit": "none",
            "decimals": 0
          },
          "overrides": []
        },
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "center",
          "orientation": "auto",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "textMode": "value_and_name",
          "text": {
            "titleSize": 14,
            "valueSize": 48
          }
        }
      },
      {
        "id": 3,
        "type": "stat",
        "title": "Branching Points",
        "gridPos": { "x": 12, "y": 0, "w": 6, "h": 6 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "branching_points_count",
            "refId": "A",
            "legendFormat": "Branches"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "fixed",
              "fixedColor": "#FF6B00"
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "#FF6B00", "value": null }
              ]
            },
            "unit": "none",
            "decimals": 0
          },
          "overrides": []
        },
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "center",
          "orientation": "auto",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "textMode": "value_and_name",
          "text": {
            "titleSize": 14,
            "valueSize": 48
          }
        }
      },
      {
        "id": 4,
        "type": "piechart",
        "title": "Events by Type",
        "gridPos": { "x": 18, "y": 0, "w": 6, "h": 6 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "events_by_type",
            "refId": "A",
            "legendFormat": "{{type}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "mappings": [],
            "unit": "none"
          },
          "overrides": [
            {
              "matcher": { "id": "byName", "options": "breakthrough" },
              "properties": [
                { "id": "color", "value": { "mode": "fixed", "fixedColor": "#00FF88" } }
              ]
            },
            {
              "matcher": { "id": "byName", "options": "crisis" },
              "properties": [
                { "id": "color", "value": { "mode": "fixed", "fixedColor": "#FF0040" } }
              ]
            },
            {
              "matcher": { "id": "byName", "options": "tech" },
              "properties": [
                { "id": "color", "value": { "mode": "fixed", "fixedColor": "#0080FF" } }
              ]
            },
            {
              "matcher": { "id": "byName", "options": "decision" },
              "properties": [
                { "id": "color", "value": { "mode": "fixed", "fixedColor": "#FFB000" } }
              ]
            }
          ]
        },
        "options": {
          "displayLabels": ["name", "percent"],
          "legend": {
            "displayMode": "table",
            "placement": "bottom",
            "showLegend": true,
            "values": ["value", "percent"]
          },
          "pieType": "donut",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "tooltip": {
            "mode": "single"
          }
        }
      },
      {
        "id": 5,
        "type": "timeseries",
        "title": "Event Rate Over Time",
        "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "rate(events_total[5m])",
            "refId": "A",
            "legendFormat": "Events/min"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "axisCenteredZero": false,
              "axisColorMode": "text",
              "axisLabel": "Events per Minute",
              "axisPlacement": "auto",
              "barAlignment": 0,
              "drawStyle": "line",
              "fillOpacity": 20,
              "gradientMode": "opacity",
              "hideFrom": {
                "tooltip": false,
                "viz": false,
                "legend": false
              },
              "lineInterpolation": "smooth",
              "lineWidth": 2,
              "pointSize": 5,
              "scaleDistribution": {
                "type": "linear"
              },
              "showPoints": "never",
              "spanNulls": false
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null }
              ]
            },
            "unit": "ops"
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "calcs": ["mean", "max"],
            "displayMode": "list",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "single"
          }
        }
      },
      {
        "id": 6,
        "type": "timeseries",
        "title": "Event Types Over Time",
        "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "events_by_type",
            "refId": "A",
            "legendFormat": "{{type}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "axisCenteredZero": false,
              "axisColorMode": "text",
              "axisLabel": "Event Count",
              "axisPlacement": "auto",
              "barAlignment": 0,
              "drawStyle": "line",
              "fillOpacity": 10,
              "gradientMode": "opacity",
              "hideFrom": {
                "tooltip": false,
                "viz": false,
                "legend": false
              },
              "lineInterpolation": "smooth",
              "lineWidth": 2,
              "pointSize": 5,
              "scaleDistribution": {
                "type": "linear"
              },
              "showPoints": "never",
              "spanNulls": false,
              "stacking": {
                "mode": "normal",
                "group": "A"
              }
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null }
              ]
            },
            "unit": "none"
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "calcs": ["lastNotNull", "sum"],
            "displayMode": "table",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        }
      },
      {
        "id": 7,
        "type": "table",
        "title": "Critical Decision Points (Recent)",
        "gridPos": { "x": 0, "y": 14, "w": 24, "h": 8 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "events_by_type{type=\"decision\"}",
            "refId": "A",
            "legendFormat": "{{type}}",
            "instant": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "custom": {
              "align": "auto",
              "displayMode": "auto",
              "inspect": false
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "showHeader": true,
          "sortBy": []
        },
        "pluginVersion": "9.0.0",
        "transformations": []
      }
    ],
    "style": "dark",
    "templating": {
      "list": []
    },
    "annotations": {
      "list": [
        {
          "builtIn": 1,
          "datasource": {
            "type": "datasource",
            "uid": "grafana"
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "target": {
            "limit": 100,
            "matchAny": false,
            "tags": [],
            "type": "dashboard"
          },
          "type": "dashboard"
        }
      ]
    }
  },
  "folderUid": "ef4v15yhwmjggd",
  "overwrite": true
}
