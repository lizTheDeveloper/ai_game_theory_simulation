{
  "dashboard": {
    "title": "Adversarial Detection",
    "uid": "sim-detection-07",
    "tags": ["simulation", "research-tool", "detection", "adversarial", "ai"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "5s",
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 1,
    "panels": [
      {
        "id": 1,
        "type": "timeseries",
        "title": "Adversarial Evaluation Scores",
        "gridPos": { "x": 0, "y": 0, "w": 24, "h": 8 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "adversarial_eval_score{agent=\"agent0\"}",
            "refId": "A",
            "legendFormat": "Agent 0"
          },
          {
            "expr": "adversarial_eval_score{agent=\"agent1\"}",
            "refId": "B",
            "legendFormat": "Agent 1"
          },
          {
            "expr": "adversarial_eval_score{agent=\"agent2\"}",
            "refId": "C",
            "legendFormat": "Agent 2"
          },
          {
            "expr": "adversarial_eval_score{agent=\"agent3\"}",
            "refId": "D",
            "legendFormat": "Agent 3"
          },
          {
            "expr": "adversarial_eval_score{agent=\"agent4\"}",
            "refId": "E",
            "legendFormat": "Agent 4"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "axisCenteredZero": false,
              "axisColorMode": "text",
              "axisLabel": "Adversarial Score",
              "axisPlacement": "auto",
              "barAlignment": 0,
              "drawStyle": "line",
              "fillOpacity": 10,
              "gradientMode": "opacity",
              "hideFrom": {
                "tooltip": false,
                "viz": false,
                "legend": false
              },
              "lineInterpolation": "smooth",
              "lineWidth": 2,
              "pointSize": 5,
              "scaleDistribution": {
                "type": "linear"
              },
              "showPoints": "never",
              "spanNulls": false,
              "stacking": {
                "group": "A",
                "mode": "none"
              },
              "thresholdsStyle": {
                "mode": "area"
              }
            },
            "mappings": [],
            "min": 0,
            "max": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "transparent", "value": null },
                { "color": "rgba(255, 176, 0, 0.1)", "value": 0.5 },
                { "color": "rgba(255, 0, 64, 0.2)", "value": 0.75 }
              ]
            },
            "unit": "percentunit"
          },
          "overrides": []
        },
        "options": {
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          },
          "legend": {
            "displayMode": "table",
            "placement": "right",
            "showLegend": true,
            "calcs": ["lastNotNull", "max"]
          }
        }
      },
      {
        "id": 2,
        "type": "table",
        "title": "Gaming Detection Matrix",
        "gridPos": { "x": 0, "y": 8, "w": 24, "h": 8 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "gaming_detected",
            "refId": "A",
            "format": "table",
            "instant": true
          },
          {
            "expr": "alignment_fidelity",
            "refId": "B",
            "format": "table",
            "instant": true
          },
          {
            "expr": "adversarial_eval_score",
            "refId": "C",
            "format": "table",
            "instant": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "custom": {
              "align": "center",
              "displayMode": "auto",
              "filterable": true,
              "inspect": false
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "transparent", "value": null }
              ]
            },
            "unit": "percentunit"
          },
          "overrides": [
            {
              "matcher": { "id": "byName", "options": "agent" },
              "properties": [
                {
                  "id": "custom.width",
