                },
                {
                  "id": "displayName",
                  "value": "Agent ID"
                },
                {
                  "id": "custom.displayMode",
                  "value": "color-text"
                },
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "#00F0FF"
                  }
                }
              ]
            },
            {
              "matcher": { "id": "byName", "options": "Value #A" },
              "properties": [
                {
                  "id": "displayName",
                  "value": "Gaming Detected"
                },
                {
                  "id": "custom.displayMode",
                  "value": "color-background-solid"
                },
                {
                  "id": "mappings",
                  "value": [
                    {
                      "type": "value",
                      "value": 0,
                      "options": {
                        "text": "CLEAR",
                        "color": "rgba(0, 255, 136, 0.2)"
                      }
                    },
                    {
                      "type": "value",
                      "value": 1,
                      "options": {
                        "text": "DETECTED",
                        "color": "rgba(255, 0, 64, 0.3)"
                      }
                    }
                  ]
                },
                {
                  "id": "unit",
                  "value": "none"
                }
              ]
            },
            {
              "matcher": { "id": "byName", "options": "Value #B" },
              "properties": [
                {
                  "id": "displayName",
                  "value": "Alignment Fidelity"
                },
                {
                  "id": "custom.displayMode",
                  "value": "gradient-gauge"
                },
                {
                  "id": "color",
                  "value": {
                    "mode": "thresholds"
                  }
                },
                {
                  "id": "thresholds",
                  "value": {
                    "mode": "absolute",
                    "steps": [
                      { "color": "#FF0040", "value": null },
                      { "color": "#FFB000", "value": 0.5 },
                      { "color": "#00FF88", "value": 0.8 }
                    ]
                  }
                },
                {
                  "id": "min",
                  "value": 0
                },
                {
                  "id": "max",
                  "value": 1
                }
              ]
            },
            {
              "matcher": { "id": "byName", "options": "Value #C" },
              "properties": [
                {
                  "id": "displayName",
                  "value": "Adversarial Score"
                },
                {
                  "id": "custom.displayMode",
                  "value": "gradient-gauge"
                },
                {
                  "id": "color",
                  "value": {
                    "mode": "thresholds"
                  }
                },
                {
                  "id": "thresholds",
                  "value": {
                    "mode": "absolute",
                    "steps": [
                      { "color": "#00FF88", "value": null },
                      { "color": "#FFB000", "value": 0.3 },
                      { "color": "#FF0040", "value": 0.6 }
                    ]
                  }
                },
                {
                  "id": "min",
                  "value": 0
                },
                {
                  "id": "max",
                  "value": 1
                }
              ]
            }
          ]
        },
        "options": {
          "showHeader": true,
          "sortBy": [
            {
              "displayName": "Adversarial Score",
              "desc": true
            }
          ],
          "footer": {
            "show": false,
            "reducer": ["sum"],
            "fields": ""
          }
        },
        "transformations": [
          {
            "id": "merge"
          },
          {
            "id": "organize",
            "options": {
              "excludeByName": {
                "Time": true,
                "__name__": true,
                "job": true,
                "instance": true
              }
            }
          }
        ]
      },
      {
        "id": 3,
        "type": "gauge",
        "title": "Average Alignment Fidelity",
        "gridPos": { "x": 0, "y": 16, "w": 8, "h": 6 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "avg(alignment_fidelity)",
            "refId": "A",
            "legendFormat": "Average"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "mappings": [],
            "min": 0,
            "max": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "#FF0040", "value": null },
                { "color": "#FFB000", "value": 0.5 },
                { "color": "#00FF88", "value": 0.8 }
              ]
            },
            "unit": "percentunit"
          },
          "overrides": []
        },
        "options": {
          "orientation": "horizontal",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "showThresholdLabels": true,
          "showThresholdMarkers": true,
          "text": {
            "titleSize": 14,
            "valueSize": 32
          }
        }
      },
      {
        "id": 4,
        "type": "barchart",
        "title": "Capability Gap Analysis",
        "gridPos": { "x": 8, "y": 16, "w": 16, "h": 6 },
