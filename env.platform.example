# ============================================================================
# MARCUS 3.0 Citation Integrity Platform
# Environment Configuration Template
#
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control
#
# @author Marcus (Platform Engineer)
# ============================================================================

# ============================================================================
# Server Configuration
# ============================================================================

# Server host and port
HOST=0.0.0.0
PORT=3000
NODE_ENV=production

# ============================================================================
# Database Configuration (PostgreSQL)
# ============================================================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=marcus_platform
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_POOL_SIZE=20

# ============================================================================
# Redis Configuration
# ============================================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your_redis_password_here
REDIS_MAX_RETRIES=3

# ============================================================================
# JWT Authentication (OWASP Task 1.4 - Secrets Management)
# ============================================================================

# CRITICAL: Generate secure random secrets (min 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

JWT_SECRET=your_jwt_secret_minimum_32_characters_required_use_crypto_random
JWT_REFRESH_SECRET=your_jwt_refresh_secret_minimum_32_characters_required_use_crypto_random

# Token TTLs (seconds)
ACCESS_TOKEN_TTL=900         # 15 minutes
REFRESH_TOKEN_TTL=604800     # 7 days

# ============================================================================
# CORS Configuration (OWASP Task 1.7)
# ============================================================================

# Allowed origins (comma-separated, NO WILDCARDS in production)
# Examples:
#   Single origin: CORS_ORIGINS=https://app.example.com
#   Multiple: CORS_ORIGINS=https://app.example.com,https://admin.example.com
#   Wildcard subdomains: CORS_ORIGINS=https://*.example.com
#   Development: CORS_ORIGINS=http://localhost:3333

CORS_ORIGINS=https://app.example.com,https://admin.example.com

# ============================================================================
# Security Headers (OWASP Task 1.8)
# ============================================================================

# Content Security Policy (CSP) - customize for your needs
# Default is strict, you may need to add trusted domains for:
# - CDNs (script-src, style-src)
# - Analytics (connect-src)
# - Image hosting (img-src)

# Example: Allow Google Fonts
# CSP_FONT_SRC='self' https://fonts.gstatic.com
# CSP_STYLE_SRC='self' 'unsafe-inline' https://fonts.googleapis.com

# Example: Allow analytics
# CSP_CONNECT_SRC='self' https://analytics.google.com

# HSTS (Strict-Transport-Security)
HSTS_MAX_AGE=31536000        # 1 year
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

# ============================================================================
# Rate Limiting (OWASP Task 1.5)
# ============================================================================

RATE_LIMITING_ENABLED=true

# Trusted proxy/load balancer IPs (comma-separated)
# These IPs will be exempt from rate limiting
TRUSTED_PROXIES=10.0.0.1,10.0.0.2

# ============================================================================
# Session Management (OWASP Task 1.12)
# ============================================================================

# Session timeouts (seconds)
SESSION_INACTIVITY_TIMEOUT=1800   # 30 minutes
SESSION_ABSOLUTE_TIMEOUT=86400    # 24 hours

# Maximum concurrent sessions per user
MAX_CONCURRENT_SESSIONS=5

# Enable CSRF protection
CSRF_PROTECTION_ENABLED=true

# ============================================================================
# Audit Logging (OWASP Task 1.11)
# ============================================================================

# Minimum severity to log (low, medium, high, critical)
AUDIT_MIN_SEVERITY=low

# Enable database persistence
AUDIT_DB_LOGGING_ENABLED=true

# Enable console logging
AUDIT_CONSOLE_LOGGING_ENABLED=true

# Retention period (days)
AUDIT_RETENTION_DAYS=365

# ============================================================================
# TLS/HTTPS Configuration (OWASP Task 1.6)
# ============================================================================

# Enable HTTPS
HTTPS_ENABLED=true

# TLS certificate paths
TLS_CERT_PATH=/path/to/cert.pem
TLS_KEY_PATH=/path/to/key.pem
TLS_CA_PATH=/path/to/ca.pem

# Minimum TLS version
TLS_MIN_VERSION=TLSv1.2

# Cipher suites (recommended)
TLS_CIPHERS=ECDHE-RSA-AES128-GCM-SHA256:ECDHE-RSA-AES256-GCM-SHA384

# ============================================================================
# Secrets Backend (OWASP Task 1.4)
# ============================================================================

# Secrets backend type (env, vault, aws)
SECRETS_BACKEND=vault

# Vault configuration (if using Vault)
VAULT_ADDR=https://vault.example.com:8200
VAULT_TOKEN=your_vault_token
VAULT_PATH=secret/marcus

# AWS Secrets Manager configuration (if using AWS)
AWS_REGION=us-west-2
AWS_SECRET_NAME=marcus/production

# ============================================================================
# Dependency Scanning (OWASP Task 1.9)
# ============================================================================

# Severity threshold for failing builds (low, moderate, high, critical)
AUDIT_FAIL_SEVERITY=high

# Snyk integration
SNYK_TOKEN=your_snyk_token_here

# ============================================================================
# Monitoring & Metrics
# ============================================================================

# Prometheus metrics endpoint
METRICS_PORT=9090

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# ============================================================================
# Development/Testing Overrides
# ============================================================================

# Test database (for running tests)
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_NAME=marcus_test
TEST_DB_USER=postgres
TEST_DB_PASSWORD=test_password

# Test Redis
TEST_REDIS_HOST=localhost
TEST_REDIS_PORT=6379
TEST_REDIS_DB=1

# ============================================================================
# API Keys (for external services)
# ============================================================================

# Anthropic API (for chatroom summarization)
ANTHROPIC_API_KEY=sk-ant-api03-...

# ============================================================================
# CRITICAL SECURITY NOTES
# ============================================================================

# 1. Never commit .env to version control
# 2. Rotate secrets regularly (every 90 days recommended)
# 3. Use strong random values for JWT secrets (min 256 bits)
# 4. In production, use a secrets manager (Vault, AWS Secrets Manager)
# 5. Limit CORS origins to exact domains (no wildcards)
# 6. Enable HTTPS in production (set HTTPS_ENABLED=true)
# 7. Review and update security headers for your specific needs
# 8. Monitor audit logs regularly for suspicious activity
# 9. Keep dependencies updated (run npm audit weekly)
# 10. Follow principle of least privilege for database users
