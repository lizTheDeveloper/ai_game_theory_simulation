#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Emoji validation (existing)
npm run validate:emojis

# NEW: Provenance validation - check for unmarked parameters
echo ""
echo "📋 Checking parameter provenance (Citation Integrity)..."

# Get staged TypeScript files in simulation/platform directories
STAGED_PROV_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^src/(simulation|platform)/.*\.ts$' | grep -v '__tests__' | grep -v '\.test\.ts$' || true)

if [ -z "$STAGED_PROV_FILES" ]; then
  echo "   ✅ No simulation/platform files changed"
else
  # Run ESLint with provenance rule on staged files
  echo "   Running provenance linter..."
  ESLINT_OUTPUT=$(npx eslint $STAGED_PROV_FILES --rule 'provenance/require-provenance: error' 2>&1 || true)

  # Check for provenance violations
  if echo "$ESLINT_OUTPUT" | grep -q "provenance/require-provenance"; then
    echo ""
    echo "❌ PROVENANCE CHECK FAILED"
    echo ""
    echo "$ESLINT_OUTPUT" | grep -A 3 "provenance/require-provenance"
    echo ""
    echo "All numeric parameters must have provenance metadata:"
    echo "  ❌ const CO2_BASELINE = 280;"
    echo "  ✅ const CO2_BASELINE = provenance(280, { name: 'CO2_BASELINE', provenance: ... });"
    echo ""
    echo "See eslint-plugin-provenance/README.md for usage."
    echo ""
    echo "If this is blocking urgent work:"
    echo "  git commit --no-verify"
    echo ""
    exit 1
  fi

  echo "   ✅ All parameters have provenance metadata"
fi

# NEW: Determinism validation - check for unsorted object iterations
echo ""
echo "🔍 Checking for unsorted object iterations (determinism)..."

# Get staged TypeScript files in simulation directory
STAGED_TS_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '^src/simulation/.*\.ts$' || true)

if [ -z "$STAGED_TS_FILES" ]; then
  echo "   ✅ No simulation files changed"
  exit 0
fi

# Check for Object.entries/keys/values without .sort()
VIOLATIONS=""

for FILE in $STAGED_TS_FILES; do
  # Check for Object.entries( not followed by .sort( within ~100 chars
  # This is a heuristic - may need refinement

  # Pattern 1: Object.entries(... ) with RNG in context
  ENTRIES_VIOLATIONS=$(grep -n "Object\.entries(" "$FILE" | grep -v "\.sort(" || true)

  # Pattern 2: Object.keys(... ) with RNG in context
  KEYS_VIOLATIONS=$(grep -n "Object\.keys(" "$FILE" | grep -v "\.sort(" || true)

  # Pattern 3: for...in loops (always suspicious in simulation code)
  FOR_IN_VIOLATIONS=$(grep -n "for\s*(.*\s*in\s*" "$FILE" || true)

  if [ -n "$ENTRIES_VIOLATIONS" ] || [ -n "$KEYS_VIOLATIONS" ] || [ -n "$FOR_IN_VIOLATIONS" ]; then
    echo ""
    echo "⚠️  $FILE has potentially unsorted object iterations:"
    [ -n "$ENTRIES_VIOLATIONS" ] && echo "   Object.entries():" && echo "$ENTRIES_VIOLATIONS" | head -3
    [ -n "$KEYS_VIOLATIONS" ] && echo "   Object.keys():" && echo "$KEYS_VIOLATIONS" | head -3
    [ -n "$FOR_IN_VIOLATIONS" ] && echo "   for...in loops:" && echo "$FOR_IN_VIOLATIONS" | head -3
    VIOLATIONS="$VIOLATIONS\n$FILE"
  fi
done

if [ -n "$VIOLATIONS" ]; then
  echo ""
  echo "❌ DETERMINISM CHECK FAILED"
  echo ""
  echo "Files with unsorted object iterations detected."
  echo "This can cause non-deterministic Monte Carlo results."
  echo ""
  echo "Fix pattern:"
  echo "  ❌ for (const [k,v] of Object.entries(obj)) { ... }"
  echo "  ✅ for (const [k,v] of Object.entries(obj).sort(([a],[b]) => a.localeCompare(b))) { ... }"
  echo ""
  echo "If this is a false positive (e.g., commutative operation):"
  echo "  git commit --no-verify"
  echo ""
  exit 1
fi

echo "   ✅ No unsorted object iterations detected"

# NEW: Integration test validation - run regression tests before commit
echo ""
echo "🧪 Running integration tests (regression prevention)..."

# Run integration tests (CRITICAL and HIGH priority paths)
npm test -- tests/integration/regressions/ tests/integration/cascades/ 2>&1 | tee /tmp/integration-test-output.txt

# Check for failures
if grep -q "# failing" /tmp/integration-test-output.txt; then
  FAIL_COUNT=$(grep "# failing" /tmp/integration-test-output.txt | head -1 | awk '{print $3}')
  echo ""
  echo "❌ INTEGRATION TESTS FAILED: $FAIL_COUNT tests failing"
  echo ""
  echo "Integration tests prevent regressions of known bugs."
  echo "Fix failing tests before committing."
  echo ""
  echo "If this is blocking urgent work:"
  echo "  git commit --no-verify"
  echo ""
  exit 1
fi

echo "   ✅ All integration tests passed"
