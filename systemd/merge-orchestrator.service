[Unit]
Description=Merge Orchestrator - Process Feature Branches
After=network.target

[Service]
Type=oneshot
User=user
WorkingDirectory=/home/user/satu/orchestrator
ExecStart=/home/user/satu/orchestrator/scripts/merge-orchestrator.sh
StandardOutput=append:/home/user/satu/shared/logs/systemd_merge.log
StandardError=append:/home/user/satu/shared/logs/systemd_merge.log
TimeoutStartSec=1800
Environment="ANTHROPIC_API_KEY=%ANTHROPIC_API_KEY%"

[Install]
WantedBy=multi-user.target
