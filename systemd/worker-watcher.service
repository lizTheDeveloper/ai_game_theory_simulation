[Unit]
Description=Autonomous Worker Health Monitor
After=network.target

[Service]
Type=oneshot
User=user
WorkingDirectory=/home/user/satu/shared
ExecStart=/home/user/satu/shared/scripts/autonomous-worker-watcher.sh
StandardOutput=append:/home/user/satu/shared/logs/systemd_watcher.log
StandardError=append:/home/user/satu/shared/logs/systemd_watcher.log
TimeoutStartSec=600
Environment="ANTHROPIC_API_KEY=%ANTHROPIC_API_KEY%"

[Install]
WantedBy=multi-user.target
