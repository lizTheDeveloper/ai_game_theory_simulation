[Unit]
Description=Autonomous Worker Health Monitor
After=network.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/home/user/ai_game_theory_simulation
ExecStart=/home/user/ai_game_theory_simulation/scripts/autonomous-worker-watcher.sh
StandardOutput=append:/home/user/ai_game_theory_simulation/logs/systemd_watcher.log
StandardError=append:/home/user/ai_game_theory_simulation/logs/systemd_watcher.log
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
