{
  "name": "ai-simulation-security",
  "version": "1.0.0",
  "description": "OWASP security configuration for AI Game Theory Simulation",
  "private": true,
  "scripts": {
    "security:audit": "npm audit --audit-level=moderate",
    "security:audit:fix": "npm audit fix",
    "security:scan": "dependency-check --project 'AI Simulation' --scan . --format HTML --format JSON --out ./security-reports",
    "security:snyk": "snyk test",
    "security:outdated": "npm outdated",
    "security:licenses": "license-checker --summary",
    "lint:security": "eslint --ext .ts --plugin security .",
    "test:security": "npm run security:audit && npm run security:scan",
    "precommit": "npm run lint:security && npm run security:audit"
  },
  "dependencies": {
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^7.1.5",
    "express-mongo-sanitize": "^2.2.0",
    "hpp": "^0.2.3",
    "joi": "^17.11.0",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "dotenv": "^16.3.1",
    "crypto": "^1.0.1",
    "validator": "^13.11.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/cors": "^2.8.17",
    "@types/hpp": "^0.2.6",
    "@types/validator": "^13.11.8",
    "typescript": "^5.3.3",
    "eslint": "^8.56.0",
    "eslint-plugin-security": "^2.1.0",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "dependency-check": "^4.1.0",
    "snyk": "^1.1274.0",
    "license-checker": "^25.0.1",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "npm run security:audit"
    ]
  }
}
