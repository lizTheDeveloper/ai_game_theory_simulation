#!/bin/bash
# Pre-commit hook: Validate emoji usage
# Enforces single-emoji-per-event from authoritative map

set -e

EMOJI_MAP="docs/EMOJI_EVENT_MAP.txt"
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo ""
echo "🎨 Validating emoji usage..."

# Check 1: Validate emoji map has no duplicates
echo "  1. Checking emoji map for duplicates..."
DUPES=$(awk -F'|' '/^[^#]/ && NF==2 {gsub(/^[ \t]+|[ \t]+$/, "", $1); print $1}' "$EMOJI_MAP" | sort | uniq -c | awk '$1 > 1 {print $2}')

if [ -n "$DUPES" ]; then
    echo -e "${RED}❌ DUPLICATE EMOJIS IN MAP:${NC}"
    echo "$DUPES"
    echo ""
    echo "Fix: Each emoji must map to exactly ONE event in $EMOJI_MAP"
    exit 1
fi
echo -e "${GREEN}     ✅ No duplicates in emoji map${NC}"

# Check 2: Extract all registered emojis from map
REGISTERED_EMOJIS=$(awk -F'|' '/^[^#]/ && NF==2 {gsub(/^[ \t]+|[ \t]+$/, "", $1); print $1}' "$EMOJI_MAP" | sort -u)

# Check 3: Find emojis used in staged simulation files
echo "  2. Checking staged files for emoji usage..."
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E 'src/simulation/.*\.ts$' || true)

if [ -z "$STAGED_FILES" ]; then
    echo -e "${GREEN}     ✅ No simulation files changed${NC}"
    echo ""
    exit 0
fi

# Extract emojis from staged files (excluding comments and error messages)
UNREGISTERED=""

for file in $STAGED_FILES; do
    # Get the staged content
    CONTENT=$(git show ":$file" 2>/dev/null || true)
    
    if [ -z "$CONTENT" ]; then
        continue
    fi

    # Find all emojis using perl (works on macOS)
    EMOJIS=$(echo "$CONTENT" | perl -C -nle 'print $1 while /(\p{Emoji_Presentation}|\p{Emoji}\x{FE0F})/g' | sort -u || true)

    for emoji in $EMOJIS; do
        # Skip error emoji (used for code errors)
        if [ "$emoji" = "❌" ]; then
            continue
        fi
        
        # Skip if in comment
        if echo "$CONTENT" | grep "^\s*//" | grep -q "$emoji"; then
            continue
        fi

        # Check if emoji is registered
        if ! echo "$REGISTERED_EMOJIS" | grep -Fxq "$emoji"; then
            UNREGISTERED="$UNREGISTERED\n  $emoji in $file"
        fi
    done
done

# Report unregistered emojis
if [ -n "$UNREGISTERED" ]; then
    echo -e "${RED}❌ UNREGISTERED EMOJIS FOUND:${NC}"
    echo -e "$UNREGISTERED"
    echo ""
    echo "Fix: Add these emojis to $EMOJI_MAP with their event names"
    echo "Or remove them if they're not event markers"
    exit 1
fi

echo -e "${GREEN}     ✅ All emojis registered${NC}"

# Check 4: Validate GameState field references (Nov 1, 2025)
echo "  3. Validating GameState field references..."

# Extract valid GameState field names from game.ts
# This gets all top-level fields in the GameState interface
VALID_FIELDS=$(awk '
  /^export interface GameState \{/,/^\}/ {
    if ($0 ~ /^  [a-zA-Z_][a-zA-Z0-9_?]*:/) {
      # Extract field name (remove ?: and : and everything after)
      gsub(/\?.*$/, "", $1);
      gsub(/:.*$/, "", $1);
      gsub(/^  /, "", $1);
      if ($1 != "") print $1;
    }
  }
' src/types/game.ts | sort -u)

if [ -z "$VALID_FIELDS" ]; then
    echo -e "${YELLOW}⚠️  Warning: Could not extract GameState fields from src/types/game.ts${NC}"
    echo ""
    exit 0
fi

# Check staged simulation files for state field references
INVALID_REFS=""
for file in $STAGED_FILES; do
    # Get the staged content
    CONTENT=$(git show ":$file" 2>/dev/null || true)

    if [ -z "$CONTENT" ]; then
        continue
    fi

    # Extract state field references (state.FIELD patterns)
    # Skip comments, strings, and common false positives
    STATE_REFS=$(echo "$CONTENT" | grep -o 'state\.[a-zA-Z_][a-zA-Z0-9_]*' | cut -d'.' -f2 | sort -u || true)

    for ref in $STATE_REFS; do
        # Skip common non-GameState references
        if [ "$ref" = "type" ] || [ "$ref" = "toString" ] || [ "$ref" = "constructor" ]; then
            continue
        fi

        # Check if field is valid
        if ! echo "$VALID_FIELDS" | grep -Fxq "$ref"; then
            INVALID_REFS="$INVALID_REFS\n  state.$ref in $file (not a top-level GameState field)"
        fi
    done
done

# Report invalid field references
if [ -n "$INVALID_REFS" ]; then
    echo -e "${YELLOW}⚠️  POSSIBLE INVALID GAMESTATE FIELD REFERENCES:${NC}"
    echo -e "$INVALID_REFS"
    echo ""
    echo -e "${YELLOW}These field names don't match top-level GameState fields.${NC}"
    echo "Check docs/GAMESTATE_QUICK_REFERENCE.md or src/types/game.ts"
    echo ""
    echo "Common mistakes:"
    echo "  state.environmental → state.environmentalAccumulation"
    echo "  state.qol → state.qualityOfLifeSystems"
    echo "  state.population → state.humanPopulationSystem"
    echo ""
    echo -e "${YELLOW}This is a WARNING - commit will proceed, but please verify field names.${NC}"
    echo ""
    # Don't exit 1 - this is a warning, not a hard failure
else
    echo -e "${GREEN}     ✅ GameState field references look valid${NC}"
fi

echo ""
echo -e "${GREEN}✅ Pre-commit validation passed${NC}"
echo ""

exit 0
