# MARCUS 3.0 - Monitoring Configuration Template
# Copy this file to .env.monitoring and fill in your values
# DO NOT COMMIT .env.monitoring - It contains VM-specific information

# VM Connection Details
MONITORING_VM_EXTERNAL_IP=your.vm.ip.address
MONITORING_VM_INTERNAL_IP=10.0.0.1
MONITORING_VM_HOSTNAME=marcus-vm
MONITORING_SSH_PORT=22
MONITORING_SSH_USER=your-ssh-username

# Monitoring Ports (default values, usually don't need to change)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
NODE_EXPORTER_PORT=9100
POSTGRES_EXPORTER_PORT=9187
REDIS_EXPORTER_PORT=9121
ALERTMANAGER_PORT=9093

# Grafana Credentials
# Default: admin/admin (CHANGE after first login!)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# URLs (accessible via SSH tunnel)
GRAFANA_URL=http://localhost:3000
PROMETHEUS_URL=http://localhost:9090

# ============================================================================
# Setup Instructions:
# ============================================================================
#
# 1. On VM: Run the interactive setup script
#    sudo ./scripts/setup_monitoring_interactive.sh
#
# 2. On Local Machine: Copy the .env.monitoring file from VM
#    scp your-user@your.vm.ip:/path/to/.env.monitoring ./
#
# 3. On Local Machine: Run the dashboard viewer
#    bash scripts/local_view_dashboards.sh
#
# ============================================================================
