# MARCUS 3.1 Platform Configuration
# DO NOT COMMIT THIS FILE - Copy to .env and fill in actual values

# GCP Configuration
GCP_PROJECT_ID=project-6d921a00-c010-437c-990
GCP_REGION=us-central1
GKE_CLUSTER_NAME=marcus-platform
ARTIFACT_REGISTRY=us-central1-docker.pkg.dev/project-6d921a00-c010-437c-990/marcus-platform

# Kubernetes Namespace
K8S_NAMESPACE=marcus-platform

# Database Configuration (PostgreSQL in-cluster)
DATABASE_HOST=postgres-primary.marcus-platform.svc.cluster.local
DATABASE_PORT=5432
DATABASE_NAME=citation_integrity
# Get actual credentials from: kubectl get secret marcus-secrets -n marcus-platform -o jsonpath='{.data.POSTGRES_USER}' | base64 -d
DATABASE_USER=<FROM_SECRET>
DATABASE_PASSWORD=<FROM_SECRET>

# Redis Configuration (Redis Cluster in-cluster)
REDIS_HOST=redis.marcus-platform.svc.cluster.local
REDIS_PORT=6379
REDIS_CLUSTER_ENABLED=true
REDIS_CLUSTER_NODES=redis-0.redis-headless.marcus-platform.svc.cluster.local:6379,redis-1.redis-headless.marcus-platform.svc.cluster.local:6379,redis-2.redis-headless.marcus-platform.svc.cluster.local:6379
# Get actual password from: kubectl get secret marcus-secrets -n marcus-platform -o jsonpath='{.data.REDIS_PASSWORD}' | base64 -d
REDIS_PASSWORD=<FROM_SECRET>

# Application Configuration
NODE_ENV=production
LOG_LEVEL=info
METRICS_ENABLED=true
TRACING_ENABLED=true

# Platform Sizing
AGENT_MAX_WORKERS=10
POSTGRES_POOL_MAX=50
POSTGRES_POOL_MIN=10
REDIS_POOL_SIZE=20

# Secrets (stored in marcus-secrets)
# Get from: kubectl get secret marcus-secrets -n marcus-platform -o jsonpath='{.data}'
JWT_SECRET=<FROM_SECRET>
JWT_REFRESH_SECRET=<FROM_SECRET>
ENCRYPTION_KEY=<FROM_SECRET>
OAUTH_CLIENT_ID=<FROM_SECRET>
OAUTH_CLIENT_SECRET=<FROM_SECRET>

# GCE Testing Instance (Optional)
GCE_TEST_VM=marcus-test-vm-e2
GCE_TEST_ZONE=us-west1-c
GCE_TEST_IP=34.19.38.132
