# MARCUS 3.0 - Test Environment Configuration
# This file is loaded during npm test to configure test database/Redis connections

# Environment
NODE_ENV=test

# Database Configuration (PostgreSQL on port 5433)
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=marcus_test
DATABASE_USER=marcus
DATABASE_PASSWORD=IWRdNzwzMtOcUosr79rrWL7fPr7ZsoQ6
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Alternative naming convention (some tests use DB_*)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=marcus_test
DB_USER=marcus
DB_PASSWORD=IWRdNzwzMtOcUosr79rrWL7fPr7ZsoQ6

# Redis Configuration (no auth for tests)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1

# JWT Secrets (for auth tests - must be at least 32 characters)
JWT_SECRET=test_jwt_secret_for_integration_tests_only_not_production_use
JWT_REFRESH_SECRET=test_jwt_refresh_secret_for_integration_tests_only_not_prod
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Agent Configuration
ENABLE_AGENTS=true
NUM_AGENTS=3
AGENT_TIMEOUT_MS=30000

# Logging
LOG_LEVEL=error

# API Keys (for tests that need them)
ANTHROPIC_API_KEY=test_key_for_integration_tests_not_real
