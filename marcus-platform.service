# MARCUS 3.0 Platform - systemd Service Unit
#
# Installation:
#   sudo cp marcus-platform.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable marcus-platform
#   sudo systemctl start marcus-platform
#
# Management:
#   sudo systemctl status marcus-platform
#   sudo systemctl stop marcus-platform
#   sudo systemctl restart marcus-platform
#   sudo journalctl -u marcus-platform -f
#
# Requirements:
#   - Node.js 18+ installed
#   - PostgreSQL 14+ running
#   - Redis 6.0+ running
#   - User 'marcus' created: sudo useradd -r -s /bin/bash marcus
#   - App directory: /opt/marcus (or update WorkingDirectory)

[Unit]
Description=MARCUS 3.0 Citation Integrity Platform
Documentation=https://github.com/404GeneNotFound/ai_game_theory_simulation
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service
ConditionPathExists=/opt/marcus

[Service]
Type=simple
User=marcus
Group=marcus
WorkingDirectory=/opt/marcus

# Environment (use EnvironmentFile for secrets)
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=2048
EnvironmentFile=/opt/marcus/.env

# Start command
ExecStart=/usr/bin/node /opt/marcus/dist/platform/startup.js

# Restart policy
Restart=on-failure
RestartSec=10s
StartLimitIntervalSec=60s
StartLimitBurst=5

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# Memory limit (optional - adjust as needed)
MemoryMax=2G
MemoryHigh=1.5G

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=marcus-platform

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/marcus/logs /opt/marcus/tmp

# Process management
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
