# Marcus Platform Secrets (Development Only)
# WARNING: NEVER use environment variables for production secrets
# Copy to .env.secrets and replace with real values

# Secrets backend configuration
SECRETS_BACKEND=env

# JWT secrets (256-bit minimum, hex-encoded recommended)
MARCUS_SECRET_JWT_SECRET=your-jwt-secret-here-minimum-32-characters-required
MARCUS_SECRET_JWT_REFRESH_SECRET=your-refresh-secret-here-minimum-32-characters-required

# Database credentials
MARCUS_SECRET_DB_USER=postgres
MARCUS_SECRET_DB_PASSWORD=your-database-password-here
MARCUS_SECRET_DB_HOST=localhost
MARCUS_SECRET_DB_PORT=5432
MARCUS_SECRET_DB_NAME=marcus_platform

# Redis credentials
MARCUS_SECRET_REDIS_PASSWORD=your-redis-password-here
MARCUS_SECRET_REDIS_HOST=localhost
MARCUS_SECRET_REDIS_PORT=6379

# TLS certificate passphrase
MARCUS_SECRET_TLS_KEY_PASSPHRASE=your-tls-passphrase-here

# Encryption keys (256-bit hex-encoded)
MARCUS_SECRET_ENCRYPTION_KEY=your-encryption-master-key-here-64-hex-chars

# API keys (optional)
# MARCUS_SECRET_API_KEYS_OPENAI=sk-...
# MARCUS_SECRET_API_KEYS_ANTHROPIC=sk-ant-...
