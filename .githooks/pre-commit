#!/bin/bash
# Pre-commit hook: Run linting and type checking (advisory only)
#
# WARNING: tsc and eslint currently report 2000+ pre-existing errors.
# This hook is advisory-only until the backlog is cleaned up.
# Blocking mode was removed because it prevented ALL commits,
# including critical security fixes (MUL-1966).
#
# To re-enable blocking: change exit 0 to set -e and remove || true

echo "Running pre-commit checks (advisory)..."

# Run type checking (non-blocking)
echo "  Type checking..."
TSC_OUTPUT=$(npx tsc --noEmit 2>&1) || true
TSC_ERRORS=$(echo "$TSC_OUTPUT" | grep -c "error TS" || true)
if [ "$TSC_ERRORS" -gt 0 ]; then
    echo "  ⚠ $TSC_ERRORS TypeScript errors (advisory — not blocking commit)"
fi

# Run linter (non-blocking)
echo "  Linting..."
LINT_OUTPUT=$(npm run lint 2>&1) || true
LINT_ERRORS=$(echo "$LINT_OUTPUT" | grep -o '[0-9]* errors' | head -1 | grep -o '[0-9]*' || true)
if [ -n "$LINT_ERRORS" ] && [ "$LINT_ERRORS" -gt 0 ]; then
    echo "  ⚠ $LINT_ERRORS lint errors (advisory — not blocking commit)"
fi

echo "Pre-commit checks complete (advisory mode)."
exit 0
