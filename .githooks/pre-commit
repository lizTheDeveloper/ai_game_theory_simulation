#!/bin/bash

# Pre-commit hook: Detect merge conflict markers
# Prevents commits containing unresolved git conflict markers (<<<<<<<, =======, >>>>>>>)
# Addresses Session 21 merge conflict issue that broke all tests
# Can be bypassed with: git commit --no-verify

set -e

echo "🔍 Checking for merge conflict markers..."

# Check staged files for conflict markers
# Pattern: Lines starting with <<<<<<<, =======, or >>>>>>>
CONFLICT_FILES=$(git diff --cached --name-only | xargs grep -l -E '^(<{7}|={7}|>{7})' 2>/dev/null || true)

if [ -n "$CONFLICT_FILES" ]; then
  echo ""
  echo "❌ ERROR: Merge conflict markers detected in staged files:"
  echo ""
  echo "$CONFLICT_FILES" | while read -r file; do
    echo "  - $file"
    echo "    Lines with markers:"
    grep -n -E '^(<{7}|={7}|>{7})' "$file" | head -3 | sed 's/^/      /'
    echo ""
  done
  echo "⚠️  Please resolve all merge conflicts before committing."
  echo ""
  echo "If conflict markers are intentional (documentation, test fixtures),"
  echo "you can bypass this check with: git commit --no-verify"
  echo ""
  exit 1
fi

echo "✅ No merge conflict markers detected"
exit 0
