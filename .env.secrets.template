# MARCUS 3.0 Secrets Template
# Copy this file to .env.secrets and fill in your actual values
# NEVER commit .env.secrets to git!

# ==============================================================================
# API Keys
# ==============================================================================

# Anthropic API Key (required)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ==============================================================================
# Database Configuration
# ==============================================================================

# Database Password (auto-generated if not provided)
# Leave empty to generate a secure random password during provisioning
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=marcus_production
DATABASE_USER=marcus

# JWT Secrets (auto-generated if not provided)
# Leave empty to generate secure random secrets during provisioning
JWT_SECRET=
JWT_REFRESH_SECRET=

# ==============================================================================
# Redis Configuration
# ==============================================================================

REDIS_HOST=localhost
REDIS_PORT=6379

# ==============================================================================
# GitHub Actions CI/CD Secrets (for production deployments)
# ==============================================================================
# To run benchmarks against your production database, add these as GitHub Secrets:
# Settings > Secrets and variables > Actions > New repository secret
#
# PROD_DATABASE_URL      = postgresql://user:password@host:5432/dbname
# PROD_DATABASE_HOST     = your-production-host.com
# PROD_DATABASE_PORT     = 5432
# PROD_DATABASE_NAME     = your_database_name
# PROD_DATABASE_USER     = your_database_user
# PROD_DATABASE_PASSWORD = your_secure_password
# PROD_REDIS_URL         = redis://your-redis-host:6379/0
#
# If these secrets are NOT set, CI/CD will use local test credentials
# (benchmark_user@localhost) with ephemeral Docker containers.
#
# The CI logs will show which credentials are being used:
# - "📊 Using PRODUCTION database credentials from GitHub Secrets"
# - "📊 Using LOCAL test database credentials (benchmark_user@localhost)"

# ==============================================================================
# Optional: Custom Configuration
# ==============================================================================
# Uncomment and modify if needed
# NODE_ENV=production
# PORT=3000
