# MARCUS 3.0 Test Environment Configuration
# Copy to .env.test and fill in real values

# Server Configuration
NODE_ENV=test
PORT=3002
HOST=0.0.0.0

# Database Configuration (Test Database)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=marcus_test
DATABASE_USER=marcus
DATABASE_PASSWORD=your_test_db_password_here
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=5

# Redis Configuration (Test DB)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=15
REDIS_PASSWORD=your_test_redis_password_here

# JWT Configuration (Test Secrets)
JWT_SECRET=your_test_jwt_secret_here
JWT_REFRESH_SECRET=your_test_jwt_refresh_secret_here
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000

# Agent Configuration
ENABLE_AGENTS=false
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9093
