# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/playwright/.cache/
/.playwright-mcp/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.template

# Secrets management (NEVER commit actual secrets)
.env.secrets
.env.local
config/secrets-vault.json
config/secrets-aws.json
*_credentials.txt
secrets/

# Secrets management (NEVER commit actual secrets)
.env.secrets
.env.local
config/secrets-vault.json
config/secrets-aws.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
monteCarloOutputs/

# Log files - all logs backed up to GCS, not committed to repo
logs/*.log
logs/**/*.log
logs/**/*.md
logs/autonomous/status_current.txt
logs/autonomous/researcher/status_current.txt
logs/autonomous/metrics_*.json

# Underdocumented tracking (constantly updating, causes merge conflicts)
docs/underdocumented_items.json

# Heap profiles
profiles/

# Claude Code conversation backups - MOVED TO superalignment-chatroom repo
# These are now symlinks to the separate repo
claude-conversations/

# Chatroom coordination - MOVED TO superalignment-chatroom repo
# This is now a symlink to the separate repo
.claude/chatroom/

# Local Claude Code settings (machine-specific overrides)
CLAUDE.local.md

# Redaction Python cache
scripts/__pycache__/
*.pyc

# Python virtual environment for Presidio
venv/
.venv/
# Large PDF files (>100MB)
research/pdfs/ipcc_2022_climate_change_2022_impacts_adaptation.pdf

# Embedding databases (large generated files)
research/embeddings/*.db
research/embeddings/*.index
research/embeddings/*.pkl

# Abstract agent team toolkit (belongs in parent directory, not this repo)
abstract_agent_team/
# Worker lock files
*.lock

# TLS Certificates (never commit private keys)
certs/
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx
.env.test
*.tar.gz
google-cloud-sdk/
.env.local
