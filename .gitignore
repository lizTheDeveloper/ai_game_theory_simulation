# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
monteCarloOutputs/

# Log files
logs/*.log

# Heap profiles
profiles/

# Claude Code conversation backups
# Raw (unredacted) backups - NEVER commit these
claude-conversations/raw/
claude-conversations/*.jsonl
claude-conversations/*/*.jsonl
!claude-conversations/sanitized/*.jsonl  # Allow sanitized versions

# Backup logs
claude-conversations/backup.log

# Redaction Python cache
scripts/__pycache__/
*.pyc

# Chatroom state tracking (agent last-read markers & active status)
.claude/chatroom/.*_lastread
.claude/chatroom/.*_active
.claude/chatroom/archive/

# Python virtual environment for Presidio
venv/
# Large PDF files (>100MB)
research/pdfs/ipcc_2022_climate_change_2022_impacts_adaptation.pdf
