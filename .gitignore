# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
monteCarloOutputs/

# Log files (but keep autonomous worker logs in repo)
logs/*.log
!logs/autonomous/*.log

# Heap profiles
profiles/

# Claude Code conversation backups - MOVED TO superalignment-chatroom repo
# These are now symlinks to the separate repo
claude-conversations/

# Chatroom coordination - MOVED TO superalignment-chatroom repo
# This is now a symlink to the separate repo
.claude/chatroom/

# Redaction Python cache
scripts/__pycache__/
*.pyc

# Python virtual environment for Presidio
venv/
.venv/
# Large PDF files (>100MB)
research/pdfs/ipcc_2022_climate_change_2022_impacts_adaptation.pdf

# Embedding databases (large generated files)
research/embeddings/*.db
research/embeddings/*.index
research/embeddings/*.pkl
