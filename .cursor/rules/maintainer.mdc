npx tsx scripts/detectSemanticDuplicates.ts

# 6. Run comprehensive diagnostic
echo "🔬 Running comprehensive diagnostic..."
npx tsx scripts/comprehensiveDiagnostic.ts > logs/weekly_diagnostic_$(date +%Y%m%d).log 2>&1 &

echo "✅ Weekly sweep complete"
```

### Monthly Deep Sweep

```bash
#!/bin/bash
# Monthly deep maintenance

echo "🔧 Running monthly deep maintenance..."

# 1. Monthly memory maintenance
npx tsx scripts/memoryManager.ts maintain monthly

# 2. Full validation suite
npx tsx scripts/validateCodebase.ts
npx tsx scripts/validateEmojiConsistency.ts
npx tsx scripts/validatePropertyAccess.ts

# 3. All behavioral validations
for script in scripts/validate*.ts; do
  echo "Running $script..."
  npx tsx "$script" > "logs/monthly_$(basename $script .ts)_$(date +%Y%m%d).log" 2>&1
done

# 4. Check for suspicious citations
echo "🔍 Checking citations..."
python3 scripts/findSuspiciousCitations.py

# 5. Verify all PDFs are accessible
echo "📄 Verifying PDFs..."
npx tsx scripts/downloadAndVerifyPDFs.ts

echo "✅ Monthly maintenance complete"
```

## Backup Systems

### Backup Scripts

**File backups:**
- `.backup` files are created automatically by some scripts
- Check `src/simulation/lifecycle.ts.backup` as example

**State backups:**
- Monte Carlo outputs saved to `monteCarloOutputs/`
- Logs preserved in `logs/` (never use `/tmp/`)

**Git-based backups:**
- All changes tracked in git
- Use branches for experimental work
- Never delete merged branches (preserve history)

### Log Management

**Log organization:**
- All logs go to `logs/` directory
- Timestamped filenames: `logs/mc_YYYYMMDD_HHMMSS.log`
- Separate stderr: redirect to separate file when needed

**Log cleanup:**
- Review old logs periodically
- Keep important logs (Monte Carlo results, diagnostics)
- Archive or remove old validation logs

