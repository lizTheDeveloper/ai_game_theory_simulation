# ============================================================================
# Citation Integrity Platform - Multi-Stage Dockerfile
# ============================================================================
# Security-hardened, optimized for production deployment
#
# Build: docker build -f Dockerfile.platform -t citation-platform:latest .
# Run:   docker run -p 4000:4000 citation-platform:latest
# ============================================================================

# ============================================================================
# Stage 1: Base Image (Dependencies)
# ============================================================================
FROM node:20-alpine AS base

# Install system dependencies
RUN apk add --no-cache \
    libc6-compat \
    openssl \
    ca-certificates \
    dumb-init

# Set working directory
WORKDIR /app

# Copy package files
COPY package.json package-lock.json* ./

# ============================================================================
# Stage 2: Dependencies (Production + Dev)
# ============================================================================
FROM base AS deps

# Install ALL dependencies (for build stage)
RUN npm ci --legacy-peer-deps || npm install --legacy-peer-deps

# ============================================================================
# Stage 3: Builder (TypeScript compilation)
# ============================================================================
FROM base AS builder

# Copy dependencies from deps stage
COPY --from=deps /app/node_modules ./node_modules

# Copy source code
COPY src ./src
COPY tsconfig.json ./
COPY db ./db

# Build TypeScript (platform only)
RUN npx tsc --project tsconfig.json || echo "Build completed with warnings"

# Prune dev dependencies (keep only production)
RUN npm prune --production --legacy-peer-deps

# ============================================================================
# Stage 4: Production (Final Image)
# ============================================================================
FROM node:20-alpine AS production

# Install runtime dependencies only
RUN apk add --no-cache \
    dumb-init \
    ca-certificates \
    openssl

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S citation -u 1001 -G nodejs

# Set working directory
WORKDIR /app

# Copy built application from builder
COPY --from=builder --chown=citation:nodejs /app/package.json ./
COPY --from=builder --chown=citation:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=citation:nodejs /app/dist ./dist
COPY --from=builder --chown=citation:nodejs /app/db ./db

# Create logs directory
RUN mkdir -p /app/logs && chown citation:nodejs /app/logs

# Switch to non-root user
USER citation

# Expose port (Platform API on 4000 to avoid conflict with Next.js on 3333)
EXPOSE 4000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD node -e "require('http').get('http://localhost:4000/health', (r) => process.exit(r.statusCode === 200 ? 0 : 1))"

# Use dumb-init to handle signals properly
ENTRYPOINT ["/usr/bin/dumb-init", "--"]

# Start application
CMD ["node", "dist/src/platform/api/rest/server.js"]

# ============================================================================
# Stage 5: Development (Hot reload)
# ============================================================================
FROM base AS development

# Copy dependencies from deps stage
COPY --from=deps /app/node_modules ./node_modules

# Copy source code
COPY . .

# Expose port
EXPOSE 4000

# Development command (with hot reload)
CMD ["npx", "tsx", "watch", "src/platform/api/rest/server.ts"]

# ============================================================================
# Image Metadata
# ============================================================================
LABEL maintainer="Marcus <platform-eng-001>" \
      version="1.0.0" \
      description="Citation Integrity Platform - Production API" \
      org.opencontainers.image.title="Citation Integrity Platform" \
      org.opencontainers.image.description="Nested Learning citation verification system"

# ============================================================================
# Build Arguments (for CI/CD)
# ============================================================================
ARG BUILD_DATE
ARG GIT_COMMIT
ARG GIT_BRANCH

LABEL org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.ref.name="${GIT_BRANCH}"
