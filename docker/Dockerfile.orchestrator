# MARCUS 3.0 - TypeScript Orchestrator
FROM node:20-slim as base

LABEL org.opencontainers.image.source="https://github.com/your-org/ai_game_theory_simulation"
LABEL org.opencontainers.image.description="MARCUS 3.0 Citation Orchestrator"
LABEL maintainer="marcus@platform.engineering"

# Set working directory
WORKDIR /app

# Install system dependencies for Python interop
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -u 1000 -s /bin/bash marcus && \
    chown -R marcus:marcus /app

# Copy package files
COPY package*.json ./
COPY tsconfig.json ./

# Install Node dependencies
RUN npm ci --only=production

# Copy platform code
COPY src/platform /app/src/platform

# Build TypeScript
RUN npm run build

# Set ownership
RUN chown -R marcus:marcus /app

# Switch to non-root user
USER marcus

# Expose API port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD node -e "require('http').get('http://localhost:3000/health', (r) => process.exit(r.statusCode === 200 ? 0 : 1))"

# Run orchestrator
CMD ["node", "dist/platform/integration/citationAgentIntegration.js"]
