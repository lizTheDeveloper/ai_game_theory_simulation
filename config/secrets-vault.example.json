{
  "backend": "vault",
  "vault": {
    "address": "https://vault.example.com:8200",
    "roleId": "${VAULT_ROLE_ID}",
    "secretId": "${VAULT_SECRET_ID}",
    "namespace": "",
    "mountPath": "secret"
  },
  "cache": {
    "enabled": true,
    "defaultTTL": 300,
    "maxSize": 100
  },
  "rotation": {
    "enabled": true,
    "checkInterval": 3600,
    "defaultSchedule": 7776000
  },
  "audit": {
    "enabled": true,
    "logSecretAccess": false,
    "logRotations": true
  }
}
