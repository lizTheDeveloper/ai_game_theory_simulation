{
  "backend": "aws",
  "aws": {
    "region": "us-east-1"
  },
  "cache": {
    "enabled": true,
    "defaultTTL": 300,
    "maxSize": 100
  },
  "rotation": {
    "enabled": true,
    "checkInterval": 3600,
    "defaultSchedule": 7776000
  },
  "audit": {
    "enabled": true,
    "logSecretAccess": false,
    "logRotations": true
  }
}
